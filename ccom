#!/usr/bin/env python3

import argparse
import hashlib
import json
import re
import subprocess
import sys
import time
import webbrowser
from pathlib import Path
from urllib.parse import urlparse

DATA_DIR = Path.home() / ".ccom"
CACHE_FILE = DATA_DIR / "cache.json"
HISTORY_FILE = DATA_DIR / "history.jsonl"

SYSTEM_PROMPT = "Generate 1-3 shell command options for macOS/zsh. Assume current directory."
SYSTEM_PROMPT_WEB = (
    "Search the web first, then generate 1-3 shell command options for macOS/zsh. "
    "Assume current directory. Reply ONLY with JSON: "
    '{"options": [{"label": "...", "command": "..."}]}'
)

SCHEMA = json.dumps({
    "type": "object",
    "properties": {
        "options": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "label": {"type": "string"},
                    "command": {"type": "string"},
                },
                "required": ["label", "command"],
            },
        }
    },
    "required": ["options"],
})


def get_cache_key(prompt: str) -> str:
    return hashlib.md5(prompt.strip().lower().encode()).hexdigest()


def load_cache() -> dict:
    if CACHE_FILE.exists():
        return json.loads(CACHE_FILE.read_text())
    return {}


def save_cache(cache: dict) -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    CACHE_FILE.write_text(json.dumps(cache, indent=2))


def log_history(prompt: str, options: list, chosen: int, cmd: str) -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    entry = {
        "ts": int(time.time()),
        "prompt": prompt,
        "options": options,
        "chosen": chosen,
        "cmd": cmd,
    }
    with HISTORY_FILE.open("a") as f:
        f.write(json.dumps(entry) + "\n")


def extract_sources(messages: list) -> list:
    seen = set()
    sources = []
    for msg in messages:
        results = msg.get("tool_use_result", {})
        if not isinstance(results, dict):
            continue
        for item in results.get("results", []):
            if not isinstance(item, dict):
                continue
            for entry in item.get("content", []):
                url = entry.get("url", "")
                if url and url not in seen:
                    seen.add(url)
                    sources.append({"title": entry.get("title", ""), "url": url})
    return sources


def parse_options_from_text(text: str) -> list:
    match = re.search(r'\{[^{}]*"options"\s*:\s*\[.*?\]\s*\}', text, re.DOTALL)
    if not match:
        return []
    try:
        return json.loads(match.group(0)).get("options", [])
    except (json.JSONDecodeError, AttributeError):
        return []


def fetch_commands(prompt: str, web: bool = False) -> tuple[list, list]:
    cmd = [
        "claude",
        "--model", "haiku",
        "-p",
        "--output-format", "json",
        "--system-prompt", SYSTEM_PROMPT_WEB if web else SYSTEM_PROMPT,
        "--no-session-persistence",
        "--setting-sources", "",
    ]
    if web:
        cmd += ["--tools", "WebSearch", "--allowedTools", "WebSearch"]
    else:
        cmd += ["--json-schema", SCHEMA]
    cmd += ["--", prompt]

    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error: {result.stderr}", file=sys.stderr)
        sys.exit(1)

    try:
        messages = json.loads(result.stdout)
        if web:
            # No json-schema with tools — parse JSON from text response
            last_assistant = messages[-2].get("message", {})
            text = ""
            for block in last_assistant.get("content", []):
                if block.get("type") == "text":
                    text += block.get("text", "")
            options = parse_options_from_text(text)
            sources = extract_sources(messages)
        else:
            options = messages[-1].get("structured_output", {}).get("options", [])
            sources = []
        return options, sources
    except (json.JSONDecodeError, IndexError, KeyError):
        print(f"Parse error: {result.stdout}", file=sys.stderr)
        sys.exit(1)


def show_sources(sources, BOLD, DIM, CYAN, GREEN, RESET):
    print()
    for i, src in enumerate(sources, 1):
        title = src.get("title") or urlparse(src["url"]).netloc
        print(f"  {CYAN}{BOLD}[{i}]{RESET} {title}")
        print(f"      {DIM}{src['url']}{RESET}")
    print()
    while True:
        choice = input(
            f"{GREEN}▶{RESET} Open {CYAN}[1-{len(sources)}]{RESET} or {DIM}b{RESET}(ack): "
        ).strip().lower()
        if choice == "b":
            print()
            return
        if choice.isdigit() and 1 <= int(choice) <= len(sources):
            webbrowser.open(sources[int(choice) - 1]["url"])


def main():
    parser = argparse.ArgumentParser(description="Convert natural language to shell commands")
    parser.add_argument("-f", "--fresh", action="store_true", help="Bypass cache")
    parser.add_argument("-w", "--web", action="store_true", help="Allow web search for answers")
    parser.add_argument("prompt", nargs="+", help="Description of what you want to do")
    args = parser.parse_args()

    prompt = " ".join(args.prompt)
    cache_key = get_cache_key(prompt)
    cache = load_cache()
    from_cache = False
    sources = []

    if not args.fresh and cache_key in cache:
        cached = cache[cache_key]
        # migrate old list format
        if isinstance(cached, list):
            cmds, sources = cached, []
        else:
            cmds = cached.get("cmds", [])
            sources = cached.get("sources", [])
        from_cache = True
    else:
        cmds, sources = fetch_commands(prompt, web=args.web)
        if cmds:
            cache[cache_key] = {"cmds": cmds, "sources": sources}
            save_cache(cache)

    if not cmds:
        print("No commands generated", file=sys.stderr)
        sys.exit(1)

    # ANSI codes (only if TTY)
    if sys.stdout.isatty():
        BOLD = "\033[1m"
        DIM = "\033[2m"
        CYAN = "\033[36m"
        YELLOW = "\033[33m"
        GREEN = "\033[32m"
        RESET = "\033[0m"
    else:
        BOLD = DIM = CYAN = YELLOW = GREEN = RESET = ""

    cache_indicator = f" {DIM}(cached){RESET}" if from_cache else ""
    web_indicator = f" {DIM}(web){RESET}" if sources else ""
    print(f"\n{DIM}─────────────────────────────{RESET}")
    print(f"  {BOLD}Claude Command{RESET} {DIM}v1.1{RESET}{web_indicator}{cache_indicator}")
    print(f"{DIM}─────────────────────────────{RESET}")

    if sources:
        domains = [urlparse(s["url"]).netloc.removeprefix("www.") for s in sources]
        unique_domains = list(dict.fromkeys(domains))
        print(f"  {DIM}Sources: {', '.join(unique_domains)}{RESET}")

    print()
    for i, opt in enumerate(cmds, 1):
        num = f"{CYAN}{BOLD}[{i}]{RESET}"
        label = f"{DIM}{opt['label']}{RESET}"
        cmd = f"{YELLOW}{opt['command']}{RESET}"
        print(f"  {num} {label}")
        print(f"      {cmd}")
        print()

    source_hint = f", {DIM}s{RESET}(ources)" if sources else ""
    while True:
        choice = input(
            f"{GREEN}▶{RESET} Run {CYAN}[1-{len(cmds)}]{RESET}{source_hint} or {DIM}q{RESET}: "
        ).strip().lower()

        if choice == "q":
            sys.exit(0)
        if choice == "s" and sources:
            show_sources(sources, BOLD, DIM, CYAN, GREEN, RESET)
            continue
        if choice.isdigit() and 1 <= int(choice) <= len(cmds):
            chosen_idx = int(choice)
            cmd = cmds[chosen_idx - 1]["command"]
            log_history(prompt, cmds, chosen_idx, cmd)
            print(f"\n{DIM}${RESET} {BOLD}{cmd}{RESET}\n")
            subprocess.run(cmd, shell=True)
            break


if __name__ == "__main__":
    main()
